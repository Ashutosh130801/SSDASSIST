# ============================================================
#  SSD / RecoverIQ — environment settings
#  HOW TO USE: copy this file to ".env" (same folder as run_local.bat)
#  i.e.  app\backend\.env   — then fill in the SMTP values below.
#  Restart run_local.bat after editing. Never commit the real .env.
# ============================================================

# ---- SMTP for HR emails (offer letter + agreement letter) ----
# For Gmail you MUST use an "App Password" (16 chars), not your normal password.
# 1) Turn on 2-Step Verification on the Google account.
# 2) Google Account -> Security -> App passwords -> create one for "Mail".
# 3) Paste that 16-char code (spaces removed) as SMTP_PASSWORD below.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ssdenterpriseshr@gmail.com
SMTP_PASSWORD=your16charapppassword
SMTP_FROM=ssdenterpriseshr@gmail.com

# Company name shown on letters / headers (optional)
COMPANY_NAME=SRI SAI DHANADA ENTERPRISES

# ---- Other (optional; run_local.bat already sets sensible local defaults) ----
# DATABASE_URL=sqlite:///./ssd_local.db
# SECRET_KEY=change-me-to-a-long-random-string
