# ============================================================
#  RecoverIQ / SSD — Docker environment
#  Copy this file to ".env" (same folder as docker-compose.yml):
#      copy .env.example .env      (Windows)
#      cp .env.example .env        (Linux/Mac)
#  Then fill in the values below and run:  docker compose up -d --build
#  docker compose reads this file automatically.
# ============================================================

# ---- REQUIRED ----
# Postgres password (the DB user is 'ssd', db is 'ssd_recovery' — set by compose).
POSTGRES_PASSWORD=ChangeThisStrongDbPassword

# JWT signing secret. Generate a long random string, e.g.:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=paste-a-long-random-string-here

# First admin (created automatically on startup).
ADMIN_EMAIL=admin@ssdenterprises.in
ADMIN_PASSWORD=Admin@2006

ENVIRONMENT=production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- OPTIONAL (leave blank to disable that feature) ----
# Maps & geocoding
LOCATIONIQ_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=

# AI assist / address cleaning (pick one)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# HR emails (offer / agreement letters) — Gmail needs an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
COMPANY_NAME=SRI SAI DHANADA ENTERPRISES

# In-app voice calling (staff↔staff)
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_SECRET=

# UPI collection links / QR
UPI_VPA=
UPI_PAYEE_NAME=SSD Enterprises

# Visit photos: leave blank to store on the local Docker volume (default, recommended).
GCS_BUCKET=

# Branding
BRAND_NAME=RecoverIQ
BRAND_TAGLINE=Collections & Recovery Intelligence

# FOS live-location ping interval (seconds)
LOCATION_PING_SECONDS=60
