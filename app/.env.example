# Copy this file to  .env  (in this same folder) and fill in real values.
# The .env file is read automatically by docker compose. NEVER commit your real .env.

# --- REQUIRED ---
# A long random string that signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=paste-a-long-random-string-here

# Password for the Postgres database (any strong string).
POSTGRES_PASSWORD=choose-a-strong-db-password

# The first admin login that gets created on first startup.
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=choose-a-strong-admin-password

# Keep this as production for a live deployment.
ENVIRONMENT=production

# --- OPTIONAL (leave blank if unused) ---
GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=
UPI_VPA=
GCS_BUCKET=
LOCATION_PING_SECONDS=60
